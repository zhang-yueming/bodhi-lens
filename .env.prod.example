# Copy this file to /opt/bodhi-lens/.env on the EC2 instance
# Fill in all values from `terraform output` results

# ECR (will be auto-updated by GitHub Actions on each deploy)
ECR_REGISTRY=<account-id>.dkr.ecr.us-east-1.amazonaws.com

# Database (choose a strong password)
DB_USER=bodhi
DB_PASSWORD=<strong-random-password>

# S3 (from terraform output s3_bucket and s3_public_url)
S3_BUCKET=<your-bucket-name>
AWS_REGION=us-east-1
S3_PUBLIC_URL=https://<your-bucket-name>.s3.us-east-1.amazonaws.com
